{
  "trailingSlash": false,
  "rewrites": [
    { "source": "/quem-sou", "destination": "/quem-sou/index.html" },
    { "source": "/exposicoes", "destination": "/exposicoes/index.html" },
    { "source": "/disponiveis", "destination": "/disponiveis/index.html" },
    { "source": "/vendidas", "destination": "/vendidas/index.html" },
    { "source": "/contato", "destination": "/contato/index.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/(img|video)/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=86400, stale-while-revalidate=604800" }]
    }
  ]
}
