# Copie para .env.local (no computador) ou cadastre cada linha em Settings > Environment Variables (Vercel).
# Sem MP_ACCESS_TOKEN, no computador o pagamento fica SIMULADO. Na Vercel, as reservas ficam desligadas.

# Mercado Pago da Antonia: Seu negocio > Configuracoes > Credenciais > Credenciais de producao > Access Token
MP_ACCESS_TOKEN=
# Opcional: assinatura secreta do webhook (Suas integracoes > Webhooks)
MP_WEBHOOK_SECRET=

# Endereco publico do site (usado no webhook), ex.: https://antoniacelia.com.br
SITE_URL=

# Banco das reservas (Vercel > Storage > Upstash for Redis). A Vercel preenche sozinha ao conectar.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Senha do painel /admin (invente uma comprida)
ADMIN_TOKEN=

# Avisos por e-mail (Resend). NOTIFY_EMAIL = quem recebe cada nova reserva.
RESEND_API_KEY=
MAIL_FROM=Antonia Celia <reservas@seudominio.com.br>
NOTIFY_EMAIL=
