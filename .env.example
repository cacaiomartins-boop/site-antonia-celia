# Painel /admin (veja ADMIN-LEIA-ME.md). Na Vercel, cadastre estas variáveis em Settings > Environment Variables.
# No computador, copie para .env.local (esse arquivo não vai para o GitHub); sem GITHUB_TOKEN o painel roda em modo de teste.
ADMIN_PASSWORD=
GITHUB_TOKEN=
# opcionais
ADMIN_SESSION_SECRET=
GITHUB_REPO=cacaiomartins-boop/site-antonia-celia
GITHUB_BRANCH=main
